{
  "appId": "com.muhasebe.app",
  "productName": "NetMuhasebe_AI",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "out/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "NetMuhasebe AI"
  }
}