{
  "name": "netmuhasebe-ai",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3000",
    "server": "cd server && node index.js",
    "start": "node server/index.js",
    "electron:dev": "electron .",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "vite": "^7.0.3"
  },
  "build": {
    "appId": "com.netmuhasebe.ai",
    "productName": "NetMuhasebe.ai",
    "files": [
      "out/**/*",
      "electron/**/*",
      "server/**/*",
      "landing.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetMuhasebe.ai"
    },
    "asar": true
  }
}